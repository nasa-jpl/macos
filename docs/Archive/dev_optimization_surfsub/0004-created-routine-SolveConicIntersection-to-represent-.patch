+	! Check for IEEE exceptions before successful return
+	CALL ieee_get_flag(ieee_invalid, ieee_invalid_flag)
+	IF (ieee_invalid_flag) THEN
+	  ! NaN was generated during computation (e.g., SQRT of negative)
+	  GO TO 98
+	END IF
