+	tmp = L*ihat                ! ihat is the incident ray direction and L is the PL
 	pr = pin + tmp              ! pr is ray incident point on current surface 
 	Nvec = S1*psi + prel + tmp  ! Nvec is direction of surface normal at ray incident point
 
