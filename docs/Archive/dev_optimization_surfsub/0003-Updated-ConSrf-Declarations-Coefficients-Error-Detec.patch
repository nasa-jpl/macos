+C***********************************************************************
+
+	FUNCTION Conic_Sag(rho, Kr, Kc) RESULT(sag)
+C***********************************************************************
+C
+C  Purpose: Compute sag (z-coordinate) of conic surface at radial distance rho
+C
+C  Conic surface equation (standard form with curvature c):
+C    z = (c*rho^2) / (1 + sqrt(1 - (1+Kc)*c^2*rho^2))
+C
+C  Where c = 1/Kr (curvature)
+C
+C  Alternative form (implicit): rho^2 = 2*Kr*z + Kc*z^2
+C
+C  Input parameters:
+C    rho = radial distance from optical axis (sqrt(x^2 + y^2))
+C    Kr  = radius of curvature (NOT curvature = 1/R)
+C    Kc  = conic constant
+C
+C  Output:
+C    sag = z-coordinate (surface height)
+C
+C  Special cases:
+C    Kc = 0:  Sphere
+C    Kc = -1: Paraboloid
+C    Kc < -1: Hyperboloid
+C    Kc > 0:  Oblate ellipsoid
+C    -1 < Kc < 0: Prolate ellipsoid
+C
+C  Implementation notes:
+C    - Internally converts Kr (radius) to c (curvature) for numerical stability
+C    - Uses curvature-based formula to avoid division by large Kr values
+C    - Returns 0 if rho = 0 (on axis)
+C    - Returns 0 if Kr → ∞ (flat surface)
+C    - Returns IEEE NaN if beyond valid aperture (proper NaN handling)
+C    - Consistent with ConSrf parameterization where Kr is radius
+C
+C  CONSISTENCY NOTE:
+C    This explicit form must be mathematically equivalent to the
+C    implicit form used in ConSrf: rho^2 = 2*Kr*z + Kc*z^2
+C    Run validate_conic_consistency.f90 after any changes.
+C
+C***********************************************************************
+	use Constants, only: TOL_ZERO
+	use, intrinsic :: ieee_arithmetic
+	
+	IMPLICIT NONE
+	
+	! Arguments
+	REAL*8, INTENT(IN) :: rho  ! Radial distance from axis
+	REAL*8, INTENT(IN) :: Kr   ! Radius of curvature
+	REAL*8, INTENT(IN) :: Kc   ! Conic constant
+	REAL*8 :: sag              ! Result: surface sag
+	
+	! Local variables
+	REAL*8 :: curv             ! Curvature c = 1/Kr
+	REAL*8 :: rho2             ! rho^2
+	REAL*8 :: curv_rho2        ! c * rho^2
+	REAL*8 :: discriminant     ! 1 - (1+Kc)*c^2*rho^2
+	REAL*8 :: sqrt_disc        ! sqrt(discriminant)
+	REAL*8 :: numerator        ! c * rho^2
+	REAL*8 :: denominator      ! 1 + sqrt(discriminant)
+	
+	! Handle trivial case: on axis
+	IF (ABS(rho) .LE. TOL_ZERO) THEN
+	  sag = 0.0d0
+	  RETURN
+	END IF
+	
+	! Handle flat surface (Kr very large or infinite)
+	! For |Kr| > 1e20, curvature is effectively zero
+	IF (ABS(Kr) .GE. 1.0d20) THEN
+	  sag = 0.0d0
+	  RETURN
+	END IF
+	
+	! Convert radius to curvature for numerical stability
+	! Using curvature avoids issues with very large Kr values
+	curv = 1.0d0 / Kr
+	
+	! Compute rho^2 and c*rho^2
+	rho2 = rho * rho
+	curv_rho2 = curv * rho2
+	
+	! Compute discriminant: 1 - (1+Kc)*c^2*rho^2
+	! Note: c^2*rho^2 = c*(c*rho^2) for better numerical properties
+	discriminant = 1.0d0 - (1.0d0 + Kc) * curv * curv_rho2
+	
+	! Check if point is beyond valid aperture
+	IF (discriminant .LT. 0.0d0) THEN
+	  ! Point is beyond the valid aperture of the conic
+	  ! Return proper IEEE NaN (quiet NaN)
+	  sag = ieee_value(sag, ieee_quiet_nan)
+	  RETURN
+	END IF
+	
+	! Compute sqrt(discriminant)
+	sqrt_disc = SQRT(discriminant)
+	
+	! Compute sag using curvature-based formula
+	! sag = (c*rho^2) / (1 + sqrt(1 - (1+Kc)*c^2*rho^2))
+	numerator = curv_rho2
+	denominator = 1.0d0 + sqrt_disc
+	
+	! Check for degenerate denominator (shouldn't happen if discriminant >= 0)
+	IF (ABS(denominator) .LE. TOL_ZERO) THEN
+	  ! Return proper IEEE NaN for numerical error
+	  sag = ieee_value(sag, ieee_quiet_nan)
+	  RETURN
+	END IF
+	
+	sag = numerator / denominator
+	
+	RETURN
+	END FUNCTION Conic_Sag
+
 C***********************************************************************
 
