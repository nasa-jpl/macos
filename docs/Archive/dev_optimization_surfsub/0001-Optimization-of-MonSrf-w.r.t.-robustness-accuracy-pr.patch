-            X1=X1+gold*(X1-X2)
-            F1=SMonomial(Kc,Kr,psi,pv,prel,ihat,coef,rad,pmon,rhoc,
-     &                   xhat,yhat,zhat,X1)
+          IF(F1*F2.LT.0d0) THEN
+            success = .TRUE.
+            RETURN
+          END IF
+          
+          ! Track minimum function value for progress monitoring
+          F_min_curr = MIN(ABS(F1), ABS(F2))
+          
+          ! Adapt expansion factor based on progress (priority order)
+          IF (J > 1 .AND. F_min_curr < 0.5d0*F_min_prev) THEN
+            ! Making excellent progress - be more aggressive
+            gold = MIN(gold * 1.2d0, gold_max)
+
+          ELSE IF (J > 1 .AND. F_min_curr > 0.9d0*F_min_prev) THEN
