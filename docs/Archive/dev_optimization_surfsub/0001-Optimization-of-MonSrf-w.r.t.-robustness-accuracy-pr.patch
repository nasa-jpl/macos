+        REAL*8, INTENT(IN) :: rad        ! Normalization radius
+        
+        ! Input arguments - Surface geometry (passed to SMonomial)
+        REAL*8, INTENT(IN) :: psi(3)     ! Surface axis direction
+        REAL*8, INTENT(IN) :: rhoc(3)    ! Reference position (pmon-pv)
+        
+        ! Input arguments - Local coordinate system (passed to SMonomial)
+        REAL*8, INTENT(IN) :: xhat(3)    ! Local x-axis direction
+        REAL*8, INTENT(IN) :: yhat(3)    ! Local y-axis direction
+        REAL*8, INTENT(IN) :: zhat(3)    ! Local z-axis (= psi)
+        
+        ! Input arguments - Ray and position (passed to SMonomial)
+        REAL*8, INTENT(IN) :: prel(3)    ! Relative position (pin-pv)
+        REAL*8, INTENT(IN) :: ihat(3)    ! Ray direction (unit vector)
+        
+        ! Input arguments - Monomial coefficients (passed to SMonomial)
+        REAL*8, INTENT(IN) :: coef(120)  ! Polynomial coefficients
+        LOGICAL, INTENT(IN) :: coef_nonzero(120)  ! Pre-calculated mask
+        
+        ! Output arguments - Success status
+        LOGICAL, INTENT(OUT) :: success  ! True if bracket found
+        
+        ! Local variables - Algorithm parameters
+        REAL*8, PARAMETER :: gold_min=1.3d0  ! Conservative expansion
+        REAL*8, PARAMETER :: gold_max=2.0d0  ! Aggressive expansion
+        INTEGER, PARAMETER :: NTRY=50        ! Maximum expansion attempts
+        
+        ! Local variables - Adaptive expansion
+        REAL*8 :: gold                   ! Current expansion factor (adaptive)
+        REAL*8 :: F_min_prev             ! Previous minimum |F| value
+        REAL*8 :: F_min_curr             ! Current minimum |F| value
+        
+        ! Local variables - Function values and loop counter
+        REAL*8 :: F1, F2                 ! Function values at X1, X2
+        INTEGER :: J                     ! Iteration counter
+        
+        success = .FALSE.
+        gold = gold_min  ! Start conservative
+        F_min_prev = HUGE(1d0)
+        
+        IF(X1.EQ.X2) THEN
+          ! Set reasonable default bracket if X1 = X2
+          X1 = X1 - 1d-7
+          X2 = X2 + 1d-7
+        END IF
+        F1 = SMonomial(Kc,Kr,psi,prel,ihat,coef,coef_nonzero,rad,rhoc,
+     &                 xhat,yhat,zhat,X1)
+        F2 = SMonomial(Kc,Kr,psi,prel,ihat,coef,coef_nonzero,rad,rhoc,
+     &                 xhat,yhat,zhat,X2)
         DO J=1,NTRY
-          IF(F1*F2.LT.0d0)RETURN
