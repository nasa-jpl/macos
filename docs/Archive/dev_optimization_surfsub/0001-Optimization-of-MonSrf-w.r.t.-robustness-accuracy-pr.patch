From b1b167ff48814c53f76376b2f934d6ef8f2ce860 Mon Sep 17 00:00:00 2001
From: TraceMoreRays <sigrist1000@gmail.com>
Date: Sat, 24 Jan 2026 18:31:53 -0800
Subject: [PATCH 1/5] Optimization of MonSrf w.r.t. robustness, accuracy,
 precision & speed. Removed critical issues causing failures incl. PAUSE
 statements, reduced multiple re-calculations of the same parameters, checked
 if Newton or Secant method applied before Brent's method would speed up (no
 Brent's method implementation is very well optimized), tested for potential
 numerical failures, included IEEE numerical module for INF and NaN handling,
 improved interface definition (removed unused variables), ...

---
 macos_f90/constants.f90 |  17 +
 macos_f90/elemsub.F     |  16 +-
 macos_f90/surfsub.F     | 858 ++++++++++++++++++++++++++++++++--------
 3 files changed, 720 insertions(+), 171 deletions(-)

diff --git a/macos_f90/constants.f90 b/macos_f90/constants.f90
index bf2a536..adace5c 100644
--- a/macos_f90/constants.f90
+++ b/macos_f90/constants.f90
@@ -34,5 +34,22 @@ MODULE Constants
       SQRT_20 = 4.472135954999579392818347337462552470881236719223051448541794491_pr, &
       SQRT_22 = 4.690415759823429554565630113544466280588228353411737153605701891_pr
 
+  ! Epsilon-based derived constants for numerical analysis
+  ! These scale automatically with the precision (pr)
+  REAL(pr), PARAMETER :: &
+      EPS_SQRT      = SQRT(EPS),              & ! ~1.49d-8  (for sqrt operations)
+      EPS_CBRT      = EPS**(1.0_pr/3.0_pr),   & ! ~6.04d-6  (for cubic operations)
+      EPS_2_3       = EPS**(2.0_pr/3.0_pr),   & ! ~1.64d-11 (for accumulated errors)
+      EPS_SQ        = EPS*EPS                   ! ~4.93d-32 (for double precision)
+
+  ! Ray tracing numerical tolerances (based on machine epsilon)
+  ! These provide consistent, precision-aware thresholds for surface intersection
+  REAL(pr), PARAMETER :: &
+      TOL_LINEAR    = EPS_CBRT,               & ! ~6d-6  Linear case threshold
+      TOL_TANGENT   = EPS_SQRT * 1e-6_pr,     & ! ~1d-14 Near-tangent detection
+      TOL_CANCEL    = 1e-4_pr,                & ! 0.01%  Cancellation detection
+      TOL_GEOM      = EPS_2_3,                & ! ~1d-11 Geometric validation
+      TOL_NORMAL    = EPS_SQ * 1e2_pr,        & ! ~1d-30 Normal magnitude threshold
+      TOL_ZERO      = EPS_CBRT * 1e-14_pr       ! ~1d-20 Near-zero threshold
 
 END MODULE Constants
