-      SUBROUTINE INTNORM(X,Y,U00,U01,U10,U11,U,DUDX,DUDY)
+!***********************************************************************
+!
+! SUBROUTINE: INTNORM
+!
+! PURPOSE: Bilinear interpolation on unit square with derivatives
+!
+! ALGORITHM: 
+!   U(x,y) = U00 + x·(U10-U00) + y·(U01-U00) + xy·(U11-U10-U01+U00)
+!   ∂U/∂x = (U10-U00) + y·(U11-U10-U01+U00)
+!   ∂U/∂y = (U01-U00) + x·(U11-U10-U01+U00)
+!
+! MODERNIZATION: PURE ELEMENTAL with INTENT declarations (Fortran 2003+)
+!                Enables vectorization and aggressive compiler optimization
+!
+!***********************************************************************
+      PURE ELEMENTAL SUBROUTINE INTNORM(X,Y,U00,U01,U10,U11,U,DUDX,DUDY)
+      !DIR$ ATTRIBUTES INLINE :: INTNORM
+      !GCC$ ATTRIBUTES hot, inline :: INTNORM
+      
       IMPLICIT NONE
-      REAL*8 X,Y,U00,U01,U10,U11,U,DUDX,DUDY,C1,C2,C3
-      C1=U10-U00
-      C2=U11-U10-U01+U00
-      C3=U01-U00
-      DUDX=C2*Y+C1
-      DUDY=C2*X+C3
-      U=DUDX*X+C3*Y+U00
-      RETURN
+      
+      !---------------------------------------------------------------------
+      ! Input arguments - Coordinates and corner values
+      !---------------------------------------------------------------------
+      REAL*8, INTENT(IN) :: X               ! x-coordinate in [0,1]
+      REAL*8, INTENT(IN) :: Y               ! y-coordinate in [0,1]
+      REAL*8, INTENT(IN) :: U00             ! Value at (0,0)
+      REAL*8, INTENT(IN) :: U01             ! Value at (0,1)
+      REAL*8, INTENT(IN) :: U10             ! Value at (1,0)
+      REAL*8, INTENT(IN) :: U11             ! Value at (1,1)
+      
+      !---------------------------------------------------------------------
+      ! Output arguments - Interpolated value and derivatives
+      !---------------------------------------------------------------------
+      REAL*8, INTENT(OUT) :: U              ! Interpolated value
+      REAL*8, INTENT(OUT) :: DUDX           ! ∂U/∂x
+      REAL*8, INTENT(OUT) :: DUDY           ! ∂U/∂y
+      
+      !---------------------------------------------------------------------
+      ! Local variables - Interpolation coefficients
+      !---------------------------------------------------------------------
+      REAL*8 :: grad_x_at_y0                ! U10 - U00 (x-gradient at y=0)
+      REAL*8 :: grad_y_at_x0                ! U01 - U00 (y-gradient at x=0)
+      REAL*8 :: mixed_deriv                 ! U11 - U10 - U01 + U00
+      
+      !=====================================================================
+      ! Compute interpolation coefficients
+      !=====================================================================
+      grad_x_at_y0 = U10 - U00
+      grad_y_at_x0 = U01 - U00
+      mixed_deriv  = U11 - U10 - U01 + U00
+      
+      !=====================================================================
+      ! Compute derivatives
+      !=====================================================================
+      DUDX = grad_x_at_y0 + Y * mixed_deriv
+      DUDY = grad_y_at_x0 + X * mixed_deriv
+      
+      !=====================================================================
+      ! Compute interpolated value
+      !=====================================================================
+      ! U = U00 + x·DUDX + y·grad_y_at_x0
+      ! Reuse DUDX to avoid recomputing grad_x_at_y0 + y·mixed_deriv
+      U = U00 + X * DUDX + Y * grad_y_at_x0
+      
       END SUBROUTINE INTNORM
 
