+        ! FUNCTION: BrentSolve
+        !
+        ! PURPOSE: Generic Brent's method root finder
+        !          Finds L such that SurfaceFunc(L) = 0 within [X1, X2]
+        !
+        ! ALGORITHM: Brent's method (1973)
+        !            - Combines bisection, secant, and inverse quadratic interpolation
+        !            - Guaranteed convergence for bracketed roots
+        !            - Superlinear convergence rate
+        !
+        ! INPUT:
+        !   X1, X2      - Bracket bounds (must bracket a root)
+        !   TOL         - Convergence tolerance
+        !   SurfaceFunc - Function to find root of (procedure pointer)
+        !
+        ! OUTPUT:
+        !   converged   - .TRUE. if converged, .FALSE. if failed
+        !   BrentSolve  - Root estimate (L value)
+        !
+        ! CONVERGENCE CRITERIA:
+        !   1. Bracket width: |XM| <= TOL1 where TOL1 = 2*EPS*|B| + 0.5*TOL
+        !   2. Residual: |F(B)| = 0 (exact zero)
+        !   3. Residual tolerance: |F(B)| < TOL (after ITMAX iterations)
+        !
+        ! ERROR HANDLING:
+        !   - Returns converged=.FALSE. if:
+        !     * NaN detected in function evaluations
+        !     * Bracket does not contain root (F(X1)*F(X2) > 0)
+        !     * Maximum iterations exceeded with |F(B)| >= TOL
+        ! -----------------------------------------------------------------------
+        REAL*8 FUNCTION BrentSolve(X1, X2, TOL, SurfaceFunc, converged)
+          use Constants, only: EPS
+          use, intrinsic :: ieee_arithmetic
+          IMPLICIT NONE
+          
+          ! Input arguments
+          REAL*8, INTENT(IN) :: X1         ! Lower bracket bound
+          REAL*8, INTENT(IN) :: X2         ! Upper bracket bound
+          REAL*8, INTENT(IN) :: TOL        ! Convergence tolerance
+          PROCEDURE(SurfaceFuncInterface) :: SurfaceFunc  ! Surface function
+          
+          ! Output arguments
+          LOGICAL, INTENT(OUT) :: converged ! Convergence flag
+          
+          ! Local variables - Brent's method state
+          REAL*8 :: A, B, C, D, E          ! Bracket points and steps
+          REAL*8 :: FA, FB, FC             ! Function values at A, B, C
+          REAL*8 :: P, Q, R, S             ! Interpolation parameters
+          REAL*8 :: TOL1, XM               ! Tolerance and midpoint
+          INTEGER :: ITER                  ! Iteration counter
