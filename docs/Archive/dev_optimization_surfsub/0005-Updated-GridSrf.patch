+              ELSE
+                ! Inverse quadratic interpolation
+                Q = FA/FC
+                R = FB/FC
+                P = S*(2d0*XM*Q*(Q-R) - (B-A)*(R-1d0))
+                Q = (Q-1d0)*(R-1d0)*(S-1d0)
+              END IF
+              
+              ! Adjust signs
+              IF (P .GT. 0d0) Q = -Q
+              P = ABS(P)
+              
+              ! Accept interpolation if step is reasonable
+              ! Condition: 2*P < min(3*XM*Q - |TOL1*Q|, |E*Q|)
+              ! This ensures:
+              !   1. Step is not too large (< 3*XM*Q)
+              !   2. Step is not too small (> TOL1)
+              !   3. Step is smaller than previous step E
+              IF (2d0*P .LT. MIN(3d0*XM*Q-ABS(TOL1*Q), ABS(E*Q))) THEN
+                ! Accept interpolation step
+                E = D
+                D = P/Q
+              ELSE
+                ! Reject interpolation, use bisection
+                D = XM
+                E = D
+              END IF
+              
+            ELSE
+              ! Conditions not met for interpolation, use bisection
+              D = XM
+              E = D
+            END IF
+            
+            ! ============================================================
+            ! UPDATE BRACKET
+            ! ============================================================
+            
+            ! Save current B as new A
+            A = B
+            FA = FB
+            
+            ! Compute new B
+            ! If step D is large enough, take full step
+            ! Otherwise, take minimum step in direction of XM
+            IF (ABS(D) .GT. TOL1) THEN
+              B = B + D
+            ELSE
+              B = B + SIGN(TOL1, XM)
+            END IF
+            
+            ! Evaluate function at new B
+            FB = SurfaceFunc(B)
+            
+            ! Check for NaN
+            IF (ieee_is_nan(FB)) THEN
+              converged = .FALSE.
+              BrentSolve = B
+              RETURN
+            END IF
+            
+          END DO
+          
+          ! ================================================================
+          ! PHASE 3: MAXIMUM ITERATIONS REACHED
+          ! ================================================================
+          
+          ! Maximum iterations reached without meeting bracket tolerance
+          ! Check if residual is acceptable (residual-based criterion)
+          IF (ABS(FB) .LT. TOL) THEN
+            ! Residual is acceptable even though bracket is large
+            converged = .TRUE.
+          ELSE
+            ! Failed to converge - residual too large
+            converged = .FALSE.
+          END IF
+          
+          BrentSolve = B
+          RETURN
+          
+        END FUNCTION BrentSolve
+        
 C***********************************************************************
 
         END MODULE surfsub
