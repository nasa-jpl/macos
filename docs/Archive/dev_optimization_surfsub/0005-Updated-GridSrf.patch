+C***********************************************************************
+C     Cubic Spline Interpolation Routines
+C     Converted from C (splicubi2.c) to Fortran 90
+C     For 2D grid cubic spline interpolations
+C     Adapted from Numerical Recipes
+C
+C     These routines provide cubic spline interpolation for 2D grid
+C     surfaces used in MACOS optical modeling. The implementation uses
+C     natural spline boundary conditions and maintains numerical
+C     robustness through IEEE arithmetic checks.
+C
+C     Key Features:
+C     - Support for up to 256 grid surfaces simultaneously
+C     - Dynamic memory allocation with automatic reallocation
+C     - Direct Fortran column-major array handling (no C transpose)
+C     - IEEE arithmetic validation for numerical stability
+C     - Efficient storage using module-level SAVE arrays
+C***********************************************************************
+
+C***********************************************************************
+C     SUBROUTINE SPLIE2F2C
+C
+C     Initialize cubic spline for a 2D grid surface.
+C     This routine is called ONCE per grid surface during initialization.
+C     It computes and stores the second derivatives needed for subsequent
+C     interpolation calls.
+C
+C     Called from: INTCUBIC (mathsub.F)
+C
+C     Arguments:
+C       x1a(m)     [IN]  - Grid points in 1st dimension (y-direction)
+C       x2a(n)     [IN]  - Grid points in 2nd dimension (x-direction)
+C       ya_f(m*n)  [IN]  - 1D array with 2D grid data (Fortran column-major)
+C                          ya_f = GridMat passed as assumed-size array
+C       m          [IN]  - Number of points in 1st dimension
+C       n          [IN]  - Number of points in 2nd dimension
+C       srf_id     [IN]  - Surface ID (1 to 256)
+C
+C     Storage:
+C       Maintains module-level storage arrays ya_storage and y2a_storage
+C       with automatic reallocation if larger grids are encountered.
+C
+C     Note on Array Ordering:
+C       GridMat(i,j) in Fortran where i=x-index, j=y-index is passed
+C       as ya_f in column-major order. The routine directly copies
+C       without transpose since we're in pure Fortran (no C boundary).
+C***********************************************************************
+
+      SUBROUTINE SPLIE2F2C(x1a,x2a,ya_f,m,n,srf_id)
+      USE, INTRINSIC :: ieee_arithmetic
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (grid coordinates)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x1a    ! Grid points in 1st dimension
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x2a    ! Grid points in 2nd dimension
+      
+      ! Input arguments (grid data)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: ya_f   ! 1D array with 2D grid data (C row-major)
+      
+      ! Input arguments (dimensions)
+      INTEGER, INTENT(IN) :: m       ! Number of points in 1st dimension
+      INTEGER, INTENT(IN) :: n       ! Number of points in 2nd dimension
+      INTEGER, INTENT(IN) :: srf_id  ! Surface ID (1 to nGridSrf)
+      
+      ! Local variables - Module-level storage (max 256 surfaces)
+      INTEGER, PARAMETER :: nGridSrf = 256
+      REAL(pr), ALLOCATABLE, SAVE :: ya_storage(:,:,:)
+      REAL(pr), ALLOCATABLE, SAVE :: y2a_storage(:,:,:)
+      INTEGER, SAVE :: max_m = 0, max_n = 0
+      LOGICAL, SAVE :: first_entry = .TRUE.
+      
+      ! Local variables - Loop indices and temporary
+      INTEGER :: i, j, idx
+      
+      ! Initialize storage on first call
+      IF (first_entry) THEN
+        ! Allocate with initial size (will be reallocated if needed)
+        max_m = m
+        max_n = n
+        ALLOCATE(ya_storage(m,n,nGridSrf))
+        ALLOCATE(y2a_storage(m,n,nGridSrf))
+        first_entry = .FALSE.
+      ELSE IF (m > max_m .OR. n > max_n) THEN
+        ! Reallocate if larger grid is needed
+        DEALLOCATE(ya_storage, y2a_storage)
+        max_m = MAX(m, max_m)
+        max_n = MAX(n, max_n)
+        ALLOCATE(ya_storage(max_m,max_n,nGridSrf))
+        ALLOCATE(y2a_storage(max_m,max_n,nGridSrf))
+      END IF
+      
+      ! Copy from 1D Fortran array to 2D storage
+      ! ya_f is GridMat(m,n) passed as 1D assumed-size array
+      ! Fortran column-major: ya_f(1:m) = GridMat(:,1), ya_f(m+1:2*m) = GridMat(:,2), etc.
+      ! Direct copy maintains the same layout
+      idx = 0
+      DO j = 1, n
+        DO i = 1, m
+          idx = idx + 1
+          ya_storage(i,j,srf_id) = ya_f(idx)
+          
+          ! Check for NaN or Inf
+          IF (.NOT. ieee_is_finite(ya_storage(i,j,srf_id))) THEN
+            WRITE(*,*) 'WARNING SPLIE2F2C: Non-finite at i,j=',i,j
+            ya_storage(i,j,srf_id) = 0.0_pr
+          END IF
+        END DO
+      END DO
+      
+      ! Compute second derivatives
+      CALL splie2_internal(x1a,x2a,ya_storage(:,:,srf_id),m,n,
+     &                     y2a_storage(:,:,srf_id))
+      
+      END SUBROUTINE SPLIE2F2C
+
+C***********************************************************************
+C     SUBROUTINE SPLIN2F2C
+C
+C     Evaluate cubic spline and compute partial derivatives at a point.
+C     This routine is called during ray tracing to interpolate grid
+C     surface height and slopes at arbitrary (x,y) coordinates.
+C
+C     Called from: INTCUBIC (mathsub.F)
+C
+C     Arguments:
+C       x1a(m)     [IN]  - Grid points in 1st dimension (y-direction)
+C       x2a(n)     [IN]  - Grid points in 2nd dimension (x-direction)
+C       m          [IN]  - Number of points in 1st dimension
+C       n          [IN]  - Number of points in 2nd dimension
+C       x1         [IN]  - Evaluation point in 1st dimension (y-coord)
+C       x2         [IN]  - Evaluation point in 2nd dimension (x-coord)
+C       fn         [OUT] - Interpolated function value at (x1,x2)
+C       dfdx1      [OUT] - Partial derivative w.r.t. x1 (df/dy)
+C       dfdx2      [OUT] - Partial derivative w.r.t. x2 (df/dx)
+C       i0         [IN]  - Grid index hint for x1 (for derivative calc)
+C       j0         [IN]  - Grid index hint for x2 (for derivative calc)
+C       srf_id     [IN]  - Surface ID (must match SPLIE2F2C call)
+C
+C     Prerequisites:
+C       SPLIE2F2C must have been called for this srf_id before calling
+C       this routine, otherwise stored spline data will not exist.
+C
+C     Note on Coordinate Convention:
+C       Due to parameter ordering in INTCUBIC, x1 corresponds to y
+C       and x2 corresponds to x in the physical coordinate system.
+C***********************************************************************
+
+      SUBROUTINE SPLIN2F2C(x1a,x2a,m,n,x1,x2,fn,dfdx1,dfdx2,
+     &                     i0,j0,srf_id)
+      USE, INTRINSIC :: ieee_arithmetic
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (grid coordinates)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x1a    ! Grid points in 1st dimension
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x2a    ! Grid points in 2nd dimension
+      
+      ! Input arguments (dimensions)
+      INTEGER, INTENT(IN) :: m       ! Number of points in 1st dimension
+      INTEGER, INTENT(IN) :: n       ! Number of points in 2nd dimension
+      INTEGER, INTENT(IN) :: srf_id  ! Surface ID (1 to nGridSrf)
+      
+      ! Input arguments (evaluation point)
+      REAL(pr), INTENT(IN) :: x1     ! Evaluation point in 1st dimension
+      REAL(pr), INTENT(IN) :: x2     ! Evaluation point in 2nd dimension
+      
+      ! Input arguments (index hints for derivatives)
+      INTEGER, INTENT(IN) :: i0      ! Grid index hint for x1
+      INTEGER, INTENT(IN) :: j0      ! Grid index hint for x2
+      
+      ! Output arguments (interpolation results)
+      REAL(pr), INTENT(OUT) :: fn    ! Interpolated function value
+      REAL(pr), INTENT(OUT) :: dfdx1 ! Partial derivative w.r.t. x1
+      REAL(pr), INTENT(OUT) :: dfdx2 ! Partial derivative w.r.t. x2
+      
+      ! Local variables - Module-level storage access
+      INTEGER, PARAMETER :: nGridSrf = 256
+      REAL(pr), ALLOCATABLE, SAVE :: ya_storage(:,:,:)
+      REAL(pr), ALLOCATABLE, SAVE :: y2a_storage(:,:,:)
+      
+      CALL splin2_internal(x1a,x2a,ya_storage(:,:,srf_id),
+     &                     y2a_storage(:,:,srf_id),
+     &                     m,n,x1,x2,i0,j0,fn,dfdx1,dfdx2)
+      
+      END SUBROUTINE SPLIN2F2C
+
+C***********************************************************************
+C     SUBROUTINE splie2_internal
+C
+C     Internal routine to compute second derivatives for 2D cubic spline.
+C     Computes 1D splines along each row (constant first index) for use
+C     in bicubic interpolation.
+C
+C     This is an internal implementation routine called only by SPLIE2F2C.
+C     Uses natural spline boundary conditions (second derivative = 0).
+C
+C     Arguments:
+C       x1a(m)     [IN]  - Grid points in 1st dimension
+C       x2a(n)     [IN]  - Grid points in 2nd dimension
+C       ya(m,n)    [IN]  - 2D grid values
+C       m          [IN]  - Number of points in 1st dimension
+C       n          [IN]  - Number of points in 2nd dimension
+C       y2a(m,n)   [OUT] - Second derivatives for spline interpolation
+C***********************************************************************
+
+      SUBROUTINE splie2_internal(x1a,x2a,ya,m,n,y2a)
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (grid coordinates)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x1a    ! Grid points in 1st dimension
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x2a    ! Grid points in 2nd dimension
+      
+      ! Input arguments (grid data)
+      REAL(pr), DIMENSION(m,*), INTENT(IN) :: ya   ! 2D grid values
+      
+      ! Input arguments (dimensions)
+      INTEGER, INTENT(IN) :: m       ! Number of points in 1st dimension
+      INTEGER, INTENT(IN) :: n       ! Number of points in 2nd dimension
+      
+      ! Output arguments (spline coefficients)
+      REAL(pr), DIMENSION(m,*), INTENT(OUT) :: y2a ! Second derivatives
+      
+      ! Local variables
+      INTEGER :: j
+      
+      ! Compute second derivatives for each row
+      DO j = 1, m
+        CALL spline_internal(x2a,ya(j,1),n,INF,INF,y2a(j,1))
+      END DO
+      
+      END SUBROUTINE splie2_internal
+
+C***********************************************************************
+C     SUBROUTINE splin2_internal
+C
+C     Internal routine for 2D cubic spline interpolation with derivatives.
+C     Performs bicubic interpolation at point (x1,x2) and computes both
+C     partial derivatives using the stored second derivative information.
+C
+C     Algorithm:
+C       1. Interpolate along each row at x2 to get column of values
+C       2. Interpolate that column along x1 to get function value
+C       3. Compute dfdx1 using derivative formula at grid index i0
+C       4. Interpolate along each column at x1 to get row of values
+C       5. Compute dfdx2 using derivative formula at grid index j0
+C
+C     This is an internal implementation routine called only by SPLIN2F2C.
+C
+C     Arguments:
+C       x1a(m)     [IN]  - Grid points in 1st dimension
+C       x2a(n)     [IN]  - Grid points in 2nd dimension
+C       ya(m,n)    [IN]  - 2D grid values
+C       y2a(m,n)   [IN]  - Second derivatives (from splie2_internal)
+C       m          [IN]  - Number of points in 1st dimension
+C       n          [IN]  - Number of points in 2nd dimension
+C       x1         [IN]  - Evaluation point in 1st dimension
+C       x2         [IN]  - Evaluation point in 2nd dimension
+C       i0         [IN]  - Grid index hint for x1 derivative
+C       j0         [IN]  - Grid index hint for x2 derivative
+C       y          [OUT] - Interpolated function value
+C       dfdx1      [OUT] - Partial derivative w.r.t. x1
+C       dfdx2      [OUT] - Partial derivative w.r.t. x2
+C
+C     Convention:
+C       i0,x1 are in vertical/'y' direction
+C       j0,x2 are in horizontal/'x' direction
+C***********************************************************************
+
+      SUBROUTINE splin2_internal(x1a,x2a,ya,y2a,m,n,x1,x2,
+     &                           i0,j0,y,dfdx1,dfdx2)
+      USE, INTRINSIC :: ieee_arithmetic
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (grid coordinates)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x1a    ! Grid points in 1st dimension
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x2a    ! Grid points in 2nd dimension
+      
+      ! Input arguments (spline data)
+      REAL(pr), DIMENSION(m,*), INTENT(IN) :: ya   ! 2D grid values
+      REAL(pr), DIMENSION(m,*), INTENT(IN) :: y2a  ! Second derivatives
+      
+      ! Input arguments (dimensions)
+      INTEGER, INTENT(IN) :: m       ! Number of points in 1st dimension
+      INTEGER, INTENT(IN) :: n       ! Number of points in 2nd dimension
+      
+      ! Input arguments (evaluation point)
+      REAL(pr), INTENT(IN) :: x1     ! Evaluation point in 1st dimension
+      REAL(pr), INTENT(IN) :: x2     ! Evaluation point in 2nd dimension
+      
+      ! Input arguments (index hints for derivatives)
+      INTEGER, INTENT(IN) :: i0      ! Grid index hint for x1
+      INTEGER, INTENT(IN) :: j0      ! Grid index hint for x2
+      
+      ! Output arguments (interpolation results)
+      REAL(pr), INTENT(OUT) :: y     ! Interpolated function value
+      REAL(pr), INTENT(OUT) :: dfdx1 ! Partial derivative w.r.t. x1
+      REAL(pr), INTENT(OUT) :: dfdx2 ! Partial derivative w.r.t. x2
+      
+      ! Local variables - Temporary arrays for interpolation
+      REAL(pr) :: ytmp1(m), yytmp1(m), ytmp2(n), yytmp2(n)
+      REAL(pr) :: ya_tmp(m), y2a_tmp(m)
+      
+      ! Local variables - Computation
+      REAL(pr) :: A, B
+      INTEGER :: i, j, i0_safe, j0_safe
+      
+      ! Step 1: Interpolate along each row at x2
+      DO j = 1, m
+        CALL splint_internal(x2a,ya(j,1),y2a(j,1),n,x2,yytmp1(j))
+      END DO
+      
+      ! Step 2: Interpolate the row results along x1
+      CALL spline_internal(x1a,yytmp1,m,INF,INF,ytmp1)
+      CALL splint_internal(x1a,yytmp1,ytmp1,m,x1,y)
+      
+      ! Step 3: Compute dfdx1 at (x1,x2)
+      i0_safe = MAX(1, MIN(i0, m-1))
+      
+      A = (x1a(i0_safe+1) - x1) / (x1a(i0_safe+1) - x1a(i0_safe))
+      B = 1.0_pr - A
+      
+      IF (ieee_is_finite(A) .AND. ieee_is_finite(B)) THEN
+        dfdx1 = (yytmp1(i0_safe+1) - yytmp1(i0_safe)) / 
+     &          (x1a(i0_safe+1) - x1a(i0_safe))
+     &        - (3.0_pr*A*A - 1.0_pr) / 6.0_pr * 
+     &          (x1a(i0_safe+1) - x1a(i0_safe)) * ytmp1(i0_safe)
+     &        + (3.0_pr*B*B - 1.0_pr) / 6.0_pr * 
+     &          (x1a(i0_safe+1) - x1a(i0_safe)) * ytmp1(i0_safe+1)
+      ELSE
+        dfdx1 = 0.0_pr
+      END IF
+      
+      ! Step 4: Compute dfdx2 - interpolate along columns at x1
+      DO j = 1, n
+        DO i = 1, m
+          ya_tmp(i) = ya(i,j)
+          y2a_tmp(i) = y2a(i,j)
+        END DO
+        CALL splint_internal(x1a,ya_tmp,y2a_tmp,m,x1,yytmp2(j))
+      END DO
+      
+      CALL spline_internal(x2a,yytmp2,n,INF,INF,ytmp2)
+      
+      ! Step 5: Compute dfdx2 at (x1,x2)
+      j0_safe = MAX(1, MIN(j0, n-1))
+      
+      A = (x2a(j0_safe+1) - x2) / (x2a(j0_safe+1) - x2a(j0_safe))
+      B = 1.0_pr - A
+      
+      IF (ieee_is_finite(A) .AND. ieee_is_finite(B)) THEN
+        dfdx2 = (yytmp2(j0_safe+1) - yytmp2(j0_safe)) / 
+     &          (x2a(j0_safe+1) - x2a(j0_safe))
+     &        - (3.0_pr*A*A - 1.0_pr) / 6.0_pr * 
+     &          (x2a(j0_safe+1) - x2a(j0_safe)) * ytmp2(j0_safe)
+     &        + (3.0_pr*B*B - 1.0_pr) / 6.0_pr * 
+     &          (x2a(j0_safe+1) - x2a(j0_safe)) * ytmp2(j0_safe+1)
+      ELSE
+        dfdx2 = 0.0_pr
+      END IF
+      
+      END SUBROUTINE splin2_internal
+
+C***********************************************************************
+C     SUBROUTINE spline_internal
+C
+C     Internal routine to compute second derivatives for 1D cubic spline.
+C     Uses tridiagonal algorithm to solve for second derivatives that
+C     produce a smooth cubic spline through the given points.
+C
+C     Boundary Conditions:
+C       If yp1 or ypn > 0.99*INF: natural spline (second derivative = 0)
+C       Otherwise: specified first derivative at boundary
+C
+C     This is an internal implementation routine called by splie2_internal
+C     and splin2_internal.
+C
+C     Arguments:
+C       x(n)       [IN]  - Grid points (must be monotonically increasing)
+C       y(n)       [IN]  - Function values at grid points
+C       n          [IN]  - Number of grid points
+C       yp1        [IN]  - First derivative at x(1), or >0.99*INF for natural
+C       ypn        [IN]  - First derivative at x(n), or >0.99*INF for natural
+C       y2(n)      [OUT] - Second derivatives at grid points
+C
+C     Algorithm:
+C       Solves tridiagonal system using forward elimination and
+C       back substitution. Includes IEEE arithmetic checks for
+C       numerical stability.
+C***********************************************************************
+
+      SUBROUTINE spline_internal(x,y,n,yp1,ypn,y2)
+      USE, INTRINSIC :: ieee_arithmetic
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (1D grid data)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: x   ! Grid points
+      REAL(pr), DIMENSION(*), INTENT(IN) :: y   ! Function values at grid points
+      
+      ! Input arguments (dimensions and boundary conditions)
+      INTEGER, INTENT(IN) :: n       ! Number of grid points
+      REAL(pr), INTENT(IN) :: yp1    ! 1st derivative at x(1) or >0.99*INF for natural
+      REAL(pr), INTENT(IN) :: ypn    ! 1st derivative at x(n) or >0.99*INF for natural
+      
+      ! Output arguments (spline coefficients)
+      REAL(pr), DIMENSION(*), INTENT(OUT) :: y2 ! Second derivatives at grid points
+      
+      ! Local variables - Loop indices
+      INTEGER :: i, k
+      
+      ! Local variables - Tridiagonal solver
+      REAL(pr) :: p, qn, sig, un
+      REAL(pr) :: u(n-1)
+      
+      ! Lower boundary condition
+      IF (yp1 > 0.99_pr * INF) THEN
+        y2(1) = 0.0_pr
+        u(1) = 0.0_pr
+      ELSE
+        y2(1) = -0.5_pr
+        u(1) = (3.0_pr / (x(2) - x(1))) * 
+     &         ((y(2) - y(1)) / (x(2) - x(1)) - yp1)
+      END IF
+      
+      ! Decomposition loop of tridiagonal algorithm
+      DO i = 2, n-1
+        sig = (x(i) - x(i-1)) / (x(i+1) - x(i-1))
+        p = sig * y2(i-1) + 2.0_pr
+        y2(i) = (sig - 1.0_pr) / p
+        u(i) = (y(i+1) - y(i)) / (x(i+1) - x(i)) - 
+     &         (y(i) - y(i-1)) / (x(i) - x(i-1))
+        u(i) = (6.0_pr * u(i) / (x(i+1) - x(i-1)) - 
+     &          sig * u(i-1)) / p
+        
+        ! Check for numerical issues
+        IF (.NOT. ieee_is_finite(y2(i)) .OR. 
+     &      .NOT. ieee_is_finite(u(i))) THEN
+          y2(i) = 0.0_pr
+          u(i) = 0.0_pr
+        END IF
+      END DO
+      
+      ! Upper boundary condition
+      IF (ypn > 0.99_pr * INF) THEN
+        qn = 0.0_pr
+        un = 0.0_pr
+      ELSE
+        qn = 0.5_pr
+        un = (3.0_pr / (x(n) - x(n-1))) * 
+     &       (ypn - (y(n) - y(n-1)) / (x(n) - x(n-1)))
+      END IF
+      
+      y2(n) = (un - qn * u(n-1)) / (qn * y2(n-1) + 1.0_pr)
+      
+      ! Back substitution loop
+      DO k = n-1, 1, -1
+        y2(k) = y2(k) * y2(k+1) + u(k)
+      END DO
+      
+      END SUBROUTINE spline_internal
+
+C***********************************************************************
+C     SUBROUTINE splint_internal
+C
+C     Internal routine for 1D cubic spline interpolation at a point.
+C     Given the function values and second derivatives at grid points,
+C     evaluates the cubic spline at an arbitrary point x.
+C
+C     Uses binary search to locate the interval containing x, then
+C     applies the cubic spline interpolation formula.
+C
+C     This is an internal implementation routine called by splin2_internal.
+C
+C     Arguments:
+C       xa(n)      [IN]  - Grid points (must be monotonically increasing)
+C       ya(n)      [IN]  - Function values at grid points
+C       y2a(n)     [IN]  - Second derivatives at grid points
+C       n          [IN]  - Number of grid points
+C       x          [IN]  - Evaluation point
+C       y          [OUT] - Interpolated value at x
+C
+C     Error Handling:
+C       - Returns ya(klo) if duplicate xa values detected
+C       - Returns 0.0 if non-finite result occurs
+C       - Includes IEEE arithmetic validation
+C
+C     Formula:
+C       y = a*ya(klo) + b*ya(khi) + 
+C           ((a^3-a)*y2a(klo) + (b^3-b)*y2a(khi)) * h^2/6
+C       where a = (xa(khi)-x)/h, b = (x-xa(klo))/h, h = xa(khi)-xa(klo)
+C***********************************************************************
+
+      SUBROUTINE splint_internal(xa,ya,y2a,n,x,y)
+      USE, INTRINSIC :: ieee_arithmetic
+      USE Kinds
+      USE Constants
+      IMPLICIT NONE
+      
+      ! Input arguments (1D spline data)
+      REAL(pr), DIMENSION(*), INTENT(IN) :: xa  ! Grid points
+      REAL(pr), DIMENSION(*), INTENT(IN) :: ya  ! Function values at grid points
+      REAL(pr), DIMENSION(*), INTENT(IN) :: y2a ! Second derivatives at grid points
+      
+      ! Input arguments (dimensions and evaluation point)
+      INTEGER, INTENT(IN) :: n       ! Number of grid points
+      REAL(pr), INTENT(IN) :: x      ! Evaluation point
+      
+      ! Output arguments (interpolation result)
+      REAL(pr), INTENT(OUT) :: y     ! Interpolated value at x
+      
+      ! Local variables - Binary search indices
+      INTEGER :: klo, khi, k
+      
+      ! Local variables - Interpolation computation
+      REAL(pr) :: h, a, b
+      
+      ! Binary search to find the right interval
+      klo = 1
+      khi = n
+      DO WHILE (khi - klo > 1)
+        k = (khi + klo) / 2
+        IF (xa(k) > x) THEN
+          khi = k
+        ELSE
+          klo = k
+        END IF
+      END DO
+      
+      h = xa(khi) - xa(klo)
+      
+      ! Check for bad input
+      IF (ABS(h) < EPS) THEN
+        y = ya(klo)
+        RETURN
+      END IF
+      
+      a = (xa(khi) - x) / h
+      b = (x - xa(klo)) / h
+      
+      y = a * ya(klo) + b * ya(khi) + 
+     &    ((a*a*a - a) * y2a(klo) + (b*b*b - b) * y2a(khi)) * 
+     &    (h*h) / 6.0_pr
+      
+      ! Check for numerical issues
+      IF (.NOT. ieee_is_finite(y)) THEN
+        y = 0.0_pr
+      END IF
+      
+      END SUBROUTINE splint_internal
 
         END MODULE math_mod
 
