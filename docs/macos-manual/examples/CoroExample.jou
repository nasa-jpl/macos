echo MACOS demonstration macro
echo
old CoroExample;
echo
echo This system is a simple coronograph. The demo
echo generates a bright on-axis (occulted) image, then
echo adds a dim, nearby but slightly off-axis image.
echo
echo Run this with macos512!
echo
echo Sketch CoroExample system
echo
pgp 4
draw 0 16 XZ                           % sketch system
stretch sqrt
echo
echo Undo occulting mask to show pupil mask and unobscured star image (sqrt stretch)
echo
mod ngridpts=128
    nObs(6)=0                          % undo occulting mask
    q
int 1                                  % pupil function
int 6                                  % unocculted PSF
pix 6 64 ;                             % blowup of PSF
echo  
echo Now redo occulting mask at the first image plane and show occulted image
echo  
pgp 4
mod ngridpts=128
    nObs(6)=3                          % redo occulting mask
    q
pix 6 64 ;                             % blowup of occulted PSF
stretch linear
echo The intensity at the second pupil, before and after the Lyot stop
int 10                                 % pupil
int 11                                 % pupil at Lyot stop
stretch sqrt
echo  
echo The on-axis intensity at the final image plane (note small numbers)
echo  
int 16                                 % on-axis PSF at detector
echo  
echo Now set up a "planet" with off-axis light, 10x dimmer
echo  
pgp 4
win Tout 1.392542d-6 0,0 0,0           % set window for composite image
compose 16 64 1.392542E-06             % build composite image
add yes                                % blowup of on-axis PSF
stop elt 11 0,0                        % set system stop at Lyot stop
ffp 6 2d-5,2d-5 yes                    % move new image off occulting mask
ors 5 yes                              % reset return surface
ors 7 yes                              % reset return surface
fex 15 yes                             % reset return surface
mod flux=0.01                          % 100x dimmer object
    q
echo  
stretch log10
echo Planet light at mask plane bypasses the mask (log stretch) 
echo  
int 6                                  % new dim image at occulting mask
echo  
echo Full composite image at focal plane: planet and residual starlight 
echo  
stretch sqrt
add yes                                % add dim image to composite image
