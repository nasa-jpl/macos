% This macro images a star through the ImageDemo telescope
% (Appendix A.7): stop at the primary, find the exit pupil,
% then the wavefront and the image
echo
echo Load prescription file ImageDemo.in
echo
old ImageDemo
echo
echo Put the system stop at the primary mirror (element 4)
echo
stop
elt
4
0 0
echo
echo Find the exit pupil and accept it as element 12
echo
fex
12
yes
echo
echo Wavefront at the exit pupil
echo
opd 12
echo
echo Image at the focal plane (element 13)
echo
int 13
