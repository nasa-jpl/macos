%   Luneberg.jou: a MACOS example macro. This macro
%   demonstrates use of non-sequential refracting
%   elements, polarization, and the gain command.

old Luneberg
draw 0 16 XZ
beam cos 8.7500000000D-01 1.5
mod nGridPts=128 q
int 16
mod nGridPts=64 q
gain 17
col
gain 17 129
pol 1,0 0,0
mod nGridPts=128 q
int 16
mod nGridPts=64 q
gain 17
col
gain 17 129
