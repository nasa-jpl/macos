% This macro generates example figures
% for Section 2 of the MACOS User Manual

old Cassegrain
modify ngridpts=51 q
spot 1 Tout                                                                            % Fig 3a
draw;;;;                                                                               % Fig 3b

spot 5 Tout                                                                            % Fig 4a
perturb 2 global 0,1e-4,0 0,0,0
spot 5 Tout                                                                            % Fig 4b
