# Section 5 on CassWithExitPupil.in (Appendix A): RRAY and TPR, COORD, FFP, PFP, FEX.
# COPY: $ROOT/docs/macos-manual/examples/CassWithExitPupil.in s05x
cd $TMP/s05x
old CassWithExitPupil
# TRANSCRIPT: s05_rray
rray
# TRANSCRIPT: s05_tpr
tpr
# TRANSCRIPT: s05_coord
coord
1
coord 5
coord 6
# TRANSCRIPT: s05_ffp
stop
obj 0,0,0
ffp 6
1e-3,-2e-3
yes
# TRANSCRIPT: s05_ffp_ray
ray 1
# TRANSCRIPT: s05_pfp
PFP 6
15e-4
20,-100
yes
# TRANSCRIPT: s05_pfp_ray
ray 1
# TRANSCRIPT-OFF
old CassWithExitPupil
stop obj 0,0,0
mod
VptElt(3,5)=-4.5
RptElt(3,5)=-4.5
fElt(5)=6
zElt(5)=6
q
# TRANSCRIPT: s05_fex_show
show 4
show 5
# TRANSCRIPT: s05_fex
fex
5
yes
# TRANSCRIPT-OFF
