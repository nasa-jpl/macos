# Section 7, the coronagraph walk (examples/CoroExample.jou; the steps of tools/figs/FIG47_55.jou on /null):
# CoroExample.in at model 512 on a 128 grid, sqrt stretch.  INT through the coronagraph with the occulter off,
# PIX unocculted and occulted (the deck's occulter is three obscurations since 65a223ec: nObs(6)=3), STRETCH,
# WINDOW, COMPOSE + ADD of the on-axis star, then STOP / FFP / ORS 5 / FEX for an off-axis star 100x dimmer,
# (CoroExample.jou's `ors 7 yes` is left out: behind the occulter ORS 7 is starved since ef15ab23 and on ifx
# returns a non-unit psi after FFP -- TRANSCRIPT_DIFF.md section 3.8),
# its INT and ADD; WIRE + DAD of the composed image (figure 62).
# MODEL: 512
# DEADLINE: 900
# COPY: $ROOT/docs/macos-manual/examples/CoroExample.in s07
cd $TMP/s07
old CoroExample.in
pgd
/null
stretch
sqrt
mod ngridpts=128
q
# TRANSCRIPT: s07_int6
mod
nObs(6)=0
q
int 6
# TRANSCRIPT: s07_int10_11
int 10
int 11
# TRANSCRIPT: s07_pix_unocc
pix 6
64

# TRANSCRIPT: s07_pix_occ
mod
nObs(6)=3
q
pix 6 64 2.804186E-06
# TRANSCRIPT: s07_stretch
stretch
log10
# TRANSCRIPT: s07_win
win
Tout
1.392542d-6
0,0
0,0
# TRANSCRIPT: s07_compose
compose
16
64
1.392542E-06
# TRANSCRIPT: s07_add
add
yes
# TRANSCRIPT: s07_stop
stop
elt
11
0,0
# TRANSCRIPT: s07_ffp
ffp
6
2d-5,2d-5
yes
# TRANSCRIPT: s07_ors5
ors
5
yes
# TRANSCRIPT: s07_fex
fex
15
yes
# TRANSCRIPT: s07_mod_flux
mod
flux=0.01
q
# TRANSCRIPT: s07_stretch_int
stretch
log10
int 6
# TRANSCRIPT-OFF
stretch
sqrt
# TRANSCRIPT: s07_add_offaxis
add
yes
# TRANSCRIPT-OFF
stretch
linear
# TRANSCRIPT: s07_wire
wire
dad
# TRANSCRIPT-OFF
