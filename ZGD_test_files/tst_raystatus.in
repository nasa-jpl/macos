
% tst_raystatus.in
% Phase 1I: Per-ray status tracking test
% Deliberately designed to produce obscured and missed rays.
%
% System:
%   Element 1 (Mirror): concave reflector with large central obscuration (r=5mm)
%     -> rays within r<5mm of center are obscured (RayStat_Obscured)
%     -> outer rays (5<r<10mm) reflect normally to focal plane
%
%   Element 2 (SmallMirror): small flat mirror offset 15mm in x
%     -> virtually all rays miss this element (RayStat_Miss or obscured at elt 1)
%     -> placed off-axis to guarantee surface intersection failure for on-axis beam
%
%   Element 3 (RefSurf): reference surface at z=-100mm
%   Element 4 (FclPlane): focal plane
%
% Expected WARN output after BUILD:
%   Surface miss: > 0
%   Obscured:     > 0

        ChfRayDir=  0.0D+00  0.0D+00  1.0D+00
        ChfRayPos=  0.0D+00  0.0D+00 -1.0D+04
          zSource=  1.0D+22

        BaseUnits=  mm
        WaveUnits=  mm

           IndRef=  1.0D+00
           Extinc=  0.0D+00
          Wavelen=  6.328D-04
             Flux=  1.0D+00

         Aperture=  1.0D+01
         Obscratn=  0.0D+00

         GridType=  Circular
         nGridpts=  11
            xGrid=  1.0D+00  0.0D+00  0.0D+00
            yGrid=  0.0D+00  1.0D+00  0.0D+00

             nElt=  3

% Main mirror: concave, f=100mm, with central circular obscuration r=5mm
             iElt=  1
          EltName=  PrimMirror
          Element=  Reflector
          Surface=  Conic
            KrElt= -2.0D+02
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00  0.0D+00
           RptElt=  0.0D+00  0.0D+00  0.0D+00
           IndRef=  1.0D+00
           Extinc=  1.0D+22
            nCoat=  0
             nObs=  1
           ObsType=  Circle
           ObsVec=   5.0D+00  0.0D+00  0.0D+00
           ApType=  None
         PropType=  Geometric
             zElt=  1.0D+22
          nECoord= -6

% Reference surface at focal plane
             iElt=  2
          EltName=  RefSurf
          Element=  Reference
          Surface=  Flat
            KrElt= -1.0D+22
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00 -1.0D+02
           RptElt=  0.0D+00  0.0D+00 -1.0D+02
           IndRef=  1.0D+00
           Extinc=  0.0D+00
            nCoat=  0
             nObs=  0
           ApType=  None
         PropType=  FarField
             zElt=  1.0D+22
          nECoord= -6

% Focal plane — rays that got through mirror and reflected to z=-100
             iElt=  3
          EltName=  FclPlane
          Element=  FocalPlane
          Surface=  Flat
            KrElt= -1.0D+22
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00 -1.0D+02
           RptElt=  0.0D+00  0.0D+00 -1.0D+02
           IndRef=  1.0D+00
           Extinc=  0.0D+00
            nCoat=  0
             nObs=  0
           ApType=  None
         PropType=  Geometric
             zElt=  1.0D+22
          nECoord= -6

         nOutCord=  5
             Tout=  1.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  1.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  1.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  0.0D+00  1.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  1.0D+00
