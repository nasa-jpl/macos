
% tst_FF_refr.in
% Phase 1B: FreeForm surface on a Refractor element — exercises FreeForm in Refractor path
% System: collimated +z beam -> FreeForm single refracting surface (n=1->1.5)
% Mon component active; psiElt same convention as reflector (normal back toward source)

        ChfRayDir=  0.0D+00  0.0D+00  1.0D+00
        ChfRayPos=  0.0D+00  0.0D+00 -1.0D+04
          zSource=  1.0D+22

        BaseUnits=  mm
        WaveUnits=  mm

           IndRef=  1.0D+00
           Extinc=  0.0D+00
          Wavelen=  6.328D-04
             Flux=  1.0D+00

         Aperture=  1.0D+01
         Obscratn=  0.0D+00

         GridType=  Circular
         nGridpts=  11
            xGrid=  1.0D+00  0.0D+00  0.0D+00
            yGrid=  0.0D+00  1.0D+00  0.0D+00

             nElt=  4

% Flat entry face: flat refractor, air (n=1) -> glass (n=1.5)
             iElt=  1
          EltName=  LensFront
          Element=  Refractor
          Surface=  Flat
            KrElt= -1.0D+22
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00  0.0D+00
           RptElt=  0.0D+00  0.0D+00  0.0D+00
           IndRef=  1.5D+00
           Extinc=  0.0D+00
            nCoat=  0
             nObs=  0
           ApType=  None
         PropType=  Geometric
             zElt=  1.0D+22
          nECoord= -6

% Curved back face: FreeForm refractor, glass (n=1.5) -> air (n=1)
% Mon component adds aberrations on top of conic base
