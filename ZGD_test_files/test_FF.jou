% test_FF.jou  -- Phase 1 FreeForm test batch
% Run: start MACOS with model size 256, then: EXEcute test_FF
%   (Model 256 needed: mGridMat=256 for 256x256 grid, bRay=500 for 11-pt grid)
%
% Tests all 8 FreeForm component combinations (1A), refractor (1B),
% Zernike types (1D), ray-status tracking (1I), and I/O round-trip (1H).
%
% Pass: no crashes; WARN prints correct bad-ray breakdown.
% -----------------------------------------------------------------

% ---- 1A-1: Conic baseline (SrfType_Conic, not FreeForm) ----
 old tst_FF_c
 build

% ---- 1A-2: FreeForm, conic only (lMon=0, lFF=0, nGridMat=0) ----
 old tst_FF_refl
 mod 1 lMon=0.0 lFF=0.0 q
 build

% ---- 1A-3: FreeForm, Mon only ----
 old tst_FF_m
 build

% ---- 1A-4: FreeForm, FF only ----
 old tst_FF_f
 build

% ---- 1A-5: FreeForm, Mon + FF ----
 old tst_FF_mf
 build

% ---- 1A-6: FreeForm, Grid only (flat.txt) ----
 old tst_FF_g
 build

% ---- 1A-7: FreeForm, Mon + Grid ----
 old tst_FF_mg
 build

% ---- 1A-8: FreeForm, FF + Grid ----
 old tst_FF_fg
 build

% ---- 1A-9: FreeForm, Mon + FF + Grid (full) ----
 old tst_FF_refl
 build

% ---- 1B: FreeForm refractor path ----
 old tst_FF_refr
 build

% ---- 1D: Zernike types ----
 old tst_FF_zern
 build

% Type 3: Fringe
 old tst_FF_zern
 mod 1 MonZernType=Fringe q
 build

% Type 8: NormNoll
 old tst_FF_zern
 mod 1 MonZernType=NormNoll q
 build

% Type 10: Noll
 old tst_FF_zern
 mod 1 MonZernType=Noll q
 build

% Type 11: ExtFringe
 old tst_FF_zern
 mod 1 MonZernType=ExtFringe q
 build

% ---- 1H: Prescription I/O round-trip ----
% (if tst_FF_rt.in already exists MACOS will ask "Replace? [YES]" — hit Return)
 old tst_FF_refl
 save tst_FF_rt
 old tst_FF_rt
 build

% ---- 1I: Ray status tracking (expect obscured rays) ----
 old tst_raystatus
 build

% ---- 1L: Wrapper regression — existing GridData test ----
 old tst_ZGD2
 build

% -----------------------------------------------------------------
% Done.  Check above output for:
%   - No STOP/ABORT messages
%   - WARN breakdown: Obscured > 0 for tst_raystatus
%   - tst_FF_c and tst_FF_refl(conic-only) give same OPD
% -----------------------------------------------------------------
