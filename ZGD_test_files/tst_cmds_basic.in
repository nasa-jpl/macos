
% tst_cmds_basic.in
% Phase 2: Basic reflector system for exercising all MACOS commands
% System: annular beam (telescope-like) -> parabolic primary -> flat fold -> focal plane
%
% Aperture = 100mm diameter (50mm radius), central obscuration = 20mm radius
% Primary: paraboloid (K=-1), R=800mm -> f=400mm
% Conic aperture type set on primary for aperture command testing
%
% Useful command sequence:
%   OLD tst_cmds_basic.in
%   BUILD
%   SPOT
%   OPD
%   ZCOEF
%   DRAW
%   PERTURB 1 dZ 0.1
%   BUILD
%   SPOT
%   RESET
%   MODIFY 1 KcElt -0.9
%   BUILD
%   OPD
%   SAVE tst_cmds_basic_out.in
%
% ---------------------------------------------------------------------------------------
% Source Definition
% ---------------------------------------------------------------------------------------

        ChfRayDir=  0.0D+00  0.0D+00  1.0D+00
        ChfRayPos=  0.0D+00  0.0D+00 -1.0D+05
          zSource=  1.0D+22

        BaseUnits=  mm
        WaveUnits=  mm

           IndRef=  1.0D+00
           Extinc=  0.0D+00
          Wavelen=  6.328D-04
             Flux=  1.0D+00

         Aperture=  5.0D+01
         Obscratn=  2.0D+01

         GridType=  Circular
         nGridpts=  11
            xGrid=  1.0D+00  0.0D+00  0.0D+00
            yGrid=  0.0D+00  1.0D+00  0.0D+00

% ---------------------------------------------------------------------------------------
% Element Definitions
% ---------------------------------------------------------------------------------------

             nElt=  3

% Parabolic primary mirror: R=800mm, K=-1 (paraboloid), aperture 100mm, obsc 20mm
             iElt=  1
          EltName=  Primary
          Element=  Reflector
          Surface=  Conic
            KrElt= -8.0D+02
            KcElt= -1.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00  0.0D+00
           RptElt=  0.0D+00  0.0D+00  0.0D+00
           IndRef=  1.0D+00
           Extinc=  1.0D+22
            nCoat=  0
             nObs=  1
           ObsType=  Circle
           ObsVec=   2.0D+01  0.0D+00  0.0D+00
           ApType=  Circular
            ApVec=  5.0D+01  0.0D+00  0.0D+00
         PropType=  Geometric
             zElt=  1.0D+22
          nECoord= -6

% Reference surface at paraxial focus z=-400mm
             iElt=  2
          EltName=  RefSurf
          Element=  Reference
          Surface=  Flat
            KrElt= -1.0D+22
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00 -4.0D+02
           RptElt=  0.0D+00  0.0D+00 -4.0D+02
           IndRef=  1.0D+00
           Extinc=  0.0D+00
            nCoat=  0
             nObs=  0
           ApType=  None
         PropType=  FarField
             zElt=  1.0D+22
          nECoord= -6

% Focal plane at z=-400mm
             iElt=  3
          EltName=  FclPlane
          Element=  FocalPlane
          Surface=  Flat
            KrElt= -1.0D+22
            KcElt=  0.0D+00
           psiElt=  0.0D+00  0.0D+00 -1.0D+00
           VptElt=  0.0D+00  0.0D+00 -4.0D+02
           RptElt=  0.0D+00  0.0D+00 -4.0D+02
           IndRef=  1.0D+00
           Extinc=  0.0D+00
            nCoat=  0
             nObs=  0
           ApType=  None
         PropType=  Geometric
             zElt=  1.0D+22
          nECoord= -6

% ---------------------------------------------------------------------------------------
% Output Coordinate System Definition
% ---------------------------------------------------------------------------------------

         nOutCord=  5
             Tout=  1.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  1.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  1.0D+00  0.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  0.0D+00  1.0D+00  0.0D+00  0.0D+00
                    0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  0.0D+00  1.0D+00
