C***********************************************************************
C  macos_help.inc
C
C  HELP command output.  Included from macos_cmd_loop.inc inside the
C  HELP dispatch branch.  Single source of truth for the user-facing
C  command list -- when a new command is added to macos_cmd_loop.inc,
C  add a line here too.
C
C  Casing convention: <UPPER prefix><lower tail>.  The uppercase part is
C  the abbreviation that LCMP() actually tests against the user input.
C  Tags after the description:
C     [Rx]   needs a loaded prescription (OLD/NEW first)
C     [BLD]  needs a built linear model (BUILD first)
C     [DIFF] needs a propagated wavefront (PROpagate first)
C***********************************************************************

      WRITE(*,*)' '
      WRITE(*,*)' MACOS command summary'
      WRITE(*,*)' Casing: UPPER part is the minimum-match abbreviation.'
      WRITE(*,*)' Tags: [Rx]=needs OLD/NEW, [BLD]=needs BUILD,'
      WRITE(*,*)'       [DIFF]=needs PROpagate'
      WRITE(*,*)' '
      WRITE(*,*)' SESSION & FILES'
      WRITE(*,*)'   QUit, END   - exit MACOS'
      WRITE(*,*)'   HELP        - this command list'
      WRITE(*,*)'   REset       - reset options & defaults to startup'
      WRITE(*,*)'   STatus      - what is loaded / built / propagated'
      WRITE(*,*)'   SUMmarize   - pretty-print the optical system'
      WRITE(*,*)'   ELTS        - list elements (type, surface)'
      WRITE(*,*)'   EXEcute     - run a .jou journal file'
      WRITE(*,*)'   JOUrnal     - generate a .jou journal file'
      WRITE(*,*)'   MREset      - reset MACOS model size (128..8192)'
      WRITE(*,*)'   ! <cmd>     - run a shell command'
      WRITE(*,*)'   PWD, CD     - working directory shell helpers'
      WRITE(*,*)'   RX, LS, LL  - list .in files / current directory'
      WRITE(*,*)'   VI, EMAcs   - open file in editor'

      CALL IACCEPT_S(i,0,1,' Hit return to continue...')

      WRITE(*,*)' '
      WRITE(*,*)' PRESCRIPTION I/O'
      WRITE(*,*)'   NEW         - start a new optical system'
      WRITE(*,*)'   OLD <file>  - load a .in prescription'
      WRITE(*,*)'   FID <id>    - load by file id (from RX listing)'
      WRITE(*,*)'   SAVe        - write current system to .in'
      WRITE(*,*)'   EXPort      - write select results to file'
      WRITE(*,*)'   SHOw <elt>  - print all data for one element [Rx]'
      WRITE(*,*)'   MODify <elt>- interactively edit one element  [Rx]'
      WRITE(*,*)' '
      WRITE(*,*)' SOURCE & WAVELENGTH'
      WRITE(*,*)'   CHIefray    - set chief-ray position/direction'
      WRITE(*,*)'   WLENS       - set wavelength list'
      WRITE(*,*)'   SWL         - sweep / step wavelength'
      WRITE(*,*)'   MULtispec   - multi-color image stacking'
      WRITE(*,*)'   NFIlt, RFIlt, SFIlt - narrow / regular / spectral'
      WRITE(*,*)'                         filter'
      WRITE(*,*)'   ATMosphere  - turbulence model on/off'
      WRITE(*,*)'   SETC, SAOpt - stop-aperture options'
      WRITE(*,*)' '
      WRITE(*,*)' RAY TRACING'
      WRITE(*,*)'   RAY <i>     - trace ray i; print state at each'
      WRITE(*,*)'                 surface                       [Rx]'
      WRITE(*,*)'   SEGraytrace <i> - trace a ray through segment i s'
      WRITE(*,*)'                 center (uses RptElt)          [Rx]'
      WRITE(*,*)'   PRAy, RRAy, TPR - alternate ray-state printers'
      WRITE(*,*)'   MAP         - print ray-to-segment map'
      WRITE(*,*)'   COOrd <elt> - beam coordinates at element    [Rx]'
      WRITE(*,*)'   ACOor       - anchor coordinates'
      WRITE(*,*)'   EFL         - system effective focal length /'
      WRITE(*,*)'                 f-ratio / plate scale          [Rx]'
      WRITE(*,*)'   BWK         - chief-ray walk vs nominal      [Rx]'
      WRITE(*,*)'   FEXit       - find exit pupil'
      WRITE(*,*)'   FSR         - free spectral range'
      WRITE(*,*)'   CENter      - center beam in system stop'
      WRITE(*,*)'   STOp        - define system stop element'
      WRITE(*,*)'   CENTRoid    - use centroid as ref point for FEX'
      WRITE(*,*)'   FFP <x,y>   - find field point that places chief'
      WRITE(*,*)'                 ray at element coordinate'
      WRITE(*,*)'   PFP <x,y>   - find field point that places chief'
      WRITE(*,*)'                 ray at pixel coordinate'
      WRITE(*,*)'   FDP         - find detector plane orientation'
      WRITE(*,*)'   SPCenter    - spot-diagram centering option'

      CALL IACCEPT_S(i,0,1,' Hit return to continue...')

      WRITE(*,*)' '
      WRITE(*,*)' BEHAVIOR TOGGLES'
      WRITE(*,*)'   LNEg/NOLNeg - allow/disallow negative pathlengths'
      WRITE(*,*)'   POLarized   - polarization tracing on'
      WRITE(*,*)'   NOPolarization - polarization off'
      WRITE(*,*)'   OBS         - spot-diagram obscuration option'
      WRITE(*,*)'   REGrid/NOREGrid - resample wavefront at element'
      WRITE(*,*)'                     during propagation'
      WRITE(*,*)'   ORS         - optimize reference surface'
      WRITE(*,*)'   SRS         - slave one ref surface to another'
      WRITE(*,*)'   NONe        - turn off plotting (no PGPLOT calls)'
      WRITE(*,*)' '
      WRITE(*,*)' SURFACE DATA'
      WRITE(*,*)'   SINt        - set up interpolated-surface data'
      WRITE(*,*)'   UDSinit     - set up user-defined-surface data'
      WRITE(*,*)' '
      WRITE(*,*)' PERTURBATION'
      WRITE(*,*)'   PERturb <elt>   - apply 6-DOF perturbation     [Rx]'
      WRITE(*,*)'   GPERturb <grp>  - perturb an element group     [Rx]'
      WRITE(*,*)'   PREad <file>    - apply perturbations from file'
      WRITE(*,*)' '
      WRITE(*,*)' LINEAR MODEL'
      WRITE(*,*)'   BUild       - build linear model from chief-ray'
      WRITE(*,*)'                 ray partials                     [Rx]'
      WRITE(*,*)'   DMBuild     - build with deformable mirror     [Rx]'
      WRITE(*,*)'   PARtials <i>- print partial derivatives, ray i [BLD]'
      WRITE(*,*)'   LPErturb    - linear-model perturb              [BLD]'
      WRITE(*,*)'   LPRead      - linear perturb from file          [BLD]'
      WRITE(*,*)'   LREset      - zero linear perturbations         [BLD]'
      WRITE(*,*)'   LSPot, LOPd - linear-model spot / OPD           [BLD]'
      WRITE(*,*)'   LPIxilate   - linear-model pixelated image      [BLD]'

      CALL IACCEPT_S(i,0,1,' Hit return to continue...')

      WRITE(*,*)' '
      WRITE(*,*)' DIFFRACTION'
      WRITE(*,*)'   PROpagate   - propagate diffraction wavefront [Rx]'
      WRITE(*,*)'   BEAm        - set beam type (Gauss, plane, ...)'
      WRITE(*,*)'   VECtor, SCAlar - vector vs scalar diffraction'
      WRITE(*,*)'                    (with POLarized)'
      WRITE(*,*)'   COMpose     - start a multi-object/color image'
      WRITE(*,*)'   ADD, DAdd   - add to / display composed image'
      WRITE(*,*)'   CADD        - add current intensity to composed'
      WRITE(*,*)'   NOIse, SEEd - image noise + RNG seed'
      WRITE(*,*)'   STRetch     - LIN / LOG / SQRT display stretch'
      WRITE(*,*)' '
      WRITE(*,*)' OUTPUTS (RAY-TRACE & DIFFRACTION)'
      WRITE(*,*)'   OPD         - wavefront error map             [Rx]'
      WRITE(*,*)'   SPOt        - spot diagram                    [Rx]'
      WRITE(*,*)'   ZABerr      - Zernike OPD aberration          [Rx]'
      WRITE(*,*)'   ZCOef       - Zernike coefficient extraction  [Rx]'
      WRITE(*,*)'   LOS         - line-of-sight output'
      WRITE(*,*)'   METcalc     - metrology beam output'
      WRITE(*,*)'   INTensity   - wavefront intensity            [DIFF]'
      WRITE(*,*)'   PIXel       - pixelated intensity output     [DIFF]'
      WRITE(*,*)'   AMPlitude   - amplitude output               [DIFF]'
      WRITE(*,*)'   PHAse, PH   - phase output                   [DIFF]'
      WRITE(*,*)'   REAl        - real & imaginary wavefront     [DIFF]'
      WRITE(*,*)'   LOG         - log10 intensity                [DIFF]'
      WRITE(*,*)'   MTF, CMTF   - modulation transfer function   [DIFF]'
      WRITE(*,*)'   IMG         - load saved image data'
      WRITE(*,*)' '
      WRITE(*,*)' PLOT STYLE'
      WRITE(*,*)'   GRAy        - gray-scale surface plot'
      WRITE(*,*)'   WIRe        - wireframe plot'
      WRITE(*,*)'   SLIce       - slice surface plot'
      WRITE(*,*)'   COLumn      - column line plot'
      WRITE(*,*)'   CONtour     - contour surface plot'
      WRITE(*,*)'   IMGmode     - toggle image polarity'
      WRITE(*,*)'                 (NEG=astro, POS=conventional)'
      WRITE(*,*)'   CIR, GIR    - color / gray image rendering'
      WRITE(*,*)'   PGP         - PGPLOT panel layout (1,2,3,4,9)'

      CALL IACCEPT_S(i,0,1,' Hit return to continue...')

      WRITE(*,*)' '
      WRITE(*,*)' FILE OUTPUT'
      WRITE(*,*)'   TEXt        - ASCII print output'
      WRITE(*,*)'   BINary      - binary image file'
      WRITE(*,*)'   FITs, WFIts - FITS / wide-FITS image file'
      WRITE(*,*)'   MAT         - MATLAB .mat file'
      WRITE(*,*)'   GETMatlabmatrix - fetch named matrix into MATLAB'
      WRITE(*,*)'                     (smacos only)'
      WRITE(*,*)' '
      WRITE(*,*)' WINDOW & POST-PROCESSING'
      WRITE(*,*)'   PLOcate     - set plot pixel-array location'
      WRITE(*,*)'   NOPLOC      - clear plot location'
      WRITE(*,*)'   PWIn        - plot window definition'
      WRITE(*,*)'   SZCo        - sizing / coordinate options'
      WRITE(*,*)'   GBS         - Gaussian beam-size post-processing'
      WRITE(*,*)'   BLUr, GBLur - blur / Gaussian blur'
      WRITE(*,*)'   GAIn        - apply gain map to intensity'
      WRITE(*,*)'   ODRaw, PGD  - outline drawing / PGPLOT diagnostics'
      WRITE(*,*)'   ROW         - extract / plot row from image'
      WRITE(*,*)' '
      WRITE(*,*)' SYSTEM OPTIMIZATION'
      WRITE(*,*)'   AVAR <elt>  - add a variable element'
      WRITE(*,*)'   MVAR <elt>  - modify a variable element'
      WRITE(*,*)'   DVAR <elt>  - delete a variable element'
      WRITE(*,*)'   VARS        - list all variable elements'
      WRITE(*,*)'   AFOV <fov>  - add a field of view'
      WRITE(*,*)'   DFOV <fov>  - delete a field of view'
      WRITE(*,*)'   FOVS        - list all fields of view'
      WRITE(*,*)'   CALib       - run system optimization'
      WRITE(*,*)'   SFOV        - select field of view'
      WRITE(*,*)' '
      WRITE(*,*)' MISC / DEBUG'
      WRITE(*,*)'   SRAy, SRT, SRTrace - older single-ray variants'
      WRITE(*,*)'                        (use RAY)'
      WRITE(*,*)'   DOPD, DOPL, ZRM     - debug / diagnostic prints'
      WRITE(*,*)'   JWST_v3d, Vis3d     - 3D rendering demo'
      WRITE(*,*)' '
