{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (Debug)",
      "type": "shell",
      "command": "source /opt/intel/oneapi/setvars.sh intel64 --force 2>/dev/null && cmake --preset debug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build (Debug)",
      "type": "shell",
      "command": "source /opt/intel/oneapi/setvars.sh intel64 --force 2>/dev/null && cmake --build build_debug -j$(nproc)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "dependsOn": "CMake Configure (Debug)"
    },
    {
      "label": "CMake Configure (Release)",
      "type": "shell",
      "command": "source /opt/intel/oneapi/setvars.sh intel64 --force 2>/dev/null && cmake --preset release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build (Release)",
      "type": "shell",
      "command": "source /opt/intel/oneapi/setvars.sh intel64 --force 2>/dev/null && cmake --build build_release -j$(nproc)",
      "group": "build",
      "problemMatcher": "$gcc",
      "dependsOn": "CMake Configure (Release)"
    }
  ]
}
