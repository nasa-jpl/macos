# macos_write_build_loc(<data_dir> <out_file>)
#
# Writes the Fortran include that gives the engine its built-in data
# directory: where a build reads macos_param.txt and macos_glass_list.txt
# when they are not in the working directory, beside the executable, or in
# $MACOS_HOME (find_macos_file in param_mod.F, lookup 4).
#
# A build that calls this must also define MACOS_BUILD_LOC_INC and put the
# directory of <out_file> on the include path of every target that compiles
# param_mod.F.  A build that does neither still compiles; it just has no
# built-in directory.
#
# The path is written in 56-character pieces joined with //, because
# param_mod.F is fixed-form and a long path on one line would run past the
# line limit.  The file is rewritten only when its content changes, so a
# re-configure does not force a rebuild.
function(macos_write_build_loc data_dir out_file)
  set(_rest "${data_dir}")
  set(_text "!     Generated by cmake/macos_build_loc.cmake -- do not edit.\n")
  string(APPEND _text "        CHARACTER(*), PARAMETER :: build_loc =\n")
  set(_join "  ")
  while(TRUE)
    string(LENGTH "${_rest}" _n)
    if(_n GREATER 56)
      string(SUBSTRING "${_rest}" 0 56 _piece)
      string(SUBSTRING "${_rest}" 56 -1 _rest)
    else()
      set(_piece "${_rest}")
      set(_rest "")
    endif()
    string(REPLACE "'" "''" _piece "${_piece}")   # Fortran doubles a quote
    string(APPEND _text "     &  ${_join}'${_piece}'\n")
    set(_join "//")
    if(_rest STREQUAL "")
      break()
    endif()
  endwhile()

  set(_old "")
  if(EXISTS "${out_file}")
    file(READ "${out_file}" _old)
  endif()
  if(NOT _old STREQUAL _text)
    file(WRITE "${out_file}" "${_text}")
  endif()
endfunction()
