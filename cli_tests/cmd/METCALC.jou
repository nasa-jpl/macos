# METCALC on the block-comment fixture, which carries two metrology beams on element 2 aimed at element 3
# (nMetPos= 2, tMetElt= 3 2); `ShowMetData= YES` is added to a COPY so each beam prints its length (cmdref:
# Outputs).  Measured 2026-10-17: a 1 mm despace of element 3 along z leaves both lengths at 0.100004999875 --
# the target points move with the element (PLAN_CONSOLIDATION 1.2 (n), measure-first for TO); the journal pins
# the two readings and that the second METCALC runs after the perturbation.  ifx wraps the beam line, gfortran
# does not -- hence the \s+ patterns.
# COPY: $ROOT/ZGD_test_files/tst_block_comment.in
! sed -i '/^ *nGridpts=/a\ ShowMetData= YES' $DECK
old $DECK
metcalc
perturb 3
global
0,0,0
0,0,1e-3
metcalc
# EXPECT: Met beam\s+1 length from Elt\s+2 Pos\s+1\s+to Elt\s+3 Pos\s+1\s+=\s+0\.10000\d*
# EXPECT: Met beam\s+2 length from Elt\s+2 Pos\s+2\s+to Elt
# EXPECT: MACOS> perturb 3[\s\S]*?Met beam\s+1 length from Elt\s+2 Pos\s+1\s+to Elt\s+3 Pos\s+1\s+=\s+0\.10000\d*
# EXPECT-NOT: Must load optical data first
# EXPECT-NOT: forrtl
