! mv $TMP/Cassegrain.in.spot5.txt $TMP/c3_sp.dat
! python3 $ROOT/cli_tests/tools/atmos_map_check.py --ep c3_4.dat --spot c3_sp.dat --dx 0.08 --r0 0.25 --lam 1e-6 --efl 22.4736 --dir $TMP
